# ── LLM (Anthropic) ──────────────────────────────────────────
# 없으면 자동으로 데모 모드(미리 준비된 응답)로 동작
ANTHROPIC_API_KEY=
# 사용할 모델명 (코드에 하드코딩하지 않음)
LLM_MODEL=claude-sonnet-5-5

# ── STT (OpenAI Whisper) ─────────────────────────────────────
# 없으면 브라우저 Web Speech API로 폴백
OPENAI_API_KEY=

# ── 데모 모드 ─────────────────────────────────────────────────
# true면 키가 있어도 미리 준비된 응답만 사용 (시연 리허설용)
DEMO_MODE=false
